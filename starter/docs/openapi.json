{
  "components": {
    "schemas": {
      "CreateNote": {
        "additionalProperties": false,
        "properties": {
          "title": {
            "description": "Whitespace is trimmed before validating 1 to 200 Unicode scalar values.",
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "type": "object"
      },
      "Data_Health": {
        "description": "Success envelope for a single JSON resource. Errors keep the Problem contract.",
        "properties": {
          "data": {
            "properties": {
              "status": {
                "type": "string"
              }
            },
            "required": [
              "status"
            ],
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "Data_Note": {
        "description": "Success envelope for a single JSON resource. Errors keep the Problem contract.",
        "properties": {
          "data": {
            "properties": {
              "created_at": {
                "format": "date-time",
                "type": "string"
              },
              "id": {
                "format": "uuid",
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "title",
              "created_at"
            ],
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "IssueCode": {
        "enum": [
          "invalid_type",
          "too_small",
          "too_big",
          "unrecognized_keys",
          "custom"
        ],
        "type": "string"
      },
      "Note": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "created_at"
        ],
        "type": "object"
      },
      "PageInfo": {
        "properties": {
          "has_more": {
            "type": "boolean"
          },
          "limit": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "next_cursor": {
            "description": "Null when there is no next page. Pass unchanged as the `after` query parameter.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "limit",
          "has_more",
          "next_cursor"
        ],
        "type": "object"
      },
      "Page_Note": {
        "properties": {
          "data": {
            "items": {
              "properties": {
                "created_at": {
                  "format": "date-time",
                  "type": "string"
                },
                "id": {
                  "format": "uuid",
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "created_at"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "page": {
            "$ref": "#/components/schemas/PageInfo"
          }
        },
        "required": [
          "data",
          "page"
        ],
        "type": "object"
      },
      "PathSegment": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "minimum": 0,
            "type": "integer"
          }
        ]
      },
      "Problem": {
        "properties": {
          "detail": {
            "type": "string"
          },
          "issues": {
            "description": "Structured validation issues; an empty path identifies the whole request.",
            "items": {
              "$ref": "#/components/schemas/ValidationIssue"
            },
            "type": "array"
          },
          "request_id": {
            "description": "Server-generated correlation ID, also returned in X-Request-ID.",
            "type": "string"
          },
          "status": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "request_id"
        ],
        "type": "object"
      },
      "ValidationIssue": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/IssueCode"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "items": {
              "$ref": "#/components/schemas/PathSegment"
            },
            "type": "array"
          }
        },
        "required": [
          "code",
          "path",
          "message"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "description": "AUTH_MODE=bearer: RS256 access token with typ=at+jwt, configured issuer/audience and required route scope. AUTH_MODE=off is only for local teaching.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Example routes require ENABLE_EXAMPLE=true. AUTH_MODE=bearer requires access tokens and scopes; off permits anonymous local teaching. See docs/http.md.",
    "license": {
      "identifier": "MIT",
      "name": "MIT"
    },
    "title": "Bracel starter",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/example/notes": {
      "get": {
        "operationId": "list",
        "parameters": [
          {
            "description": "Page size, from 1 through 100. Defaults to 25.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 25,
              "format": "int64",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Opaque cursor from the previous page, at most 1024 bytes.",
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "maxLength": 1024,
              "type": "string"
            }
          },
          {
            "description": "Stable order with a unique tie-breaker",
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "default": "-created_at",
              "enum": [
                "created_at",
                "-created_at"
              ],
              "type": "string"
            }
          },
          {
            "description": "Exact UUID",
            "in": "query",
            "name": "filter[id]",
            "required": false,
            "schema": {
              "format": "uuid",
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "description": "Case-sensitive substring; % and _ are literal",
            "in": "query",
            "name": "filter[title]",
            "required": false,
            "schema": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "description": "Exact, case-sensitive text",
            "in": "query",
            "name": "filter[title_exact]",
            "required": false,
            "schema": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "description": "Inclusive lower bound; microsecond precision",
            "in": "query",
            "name": "filter[created_after]",
            "required": false,
            "schema": {
              "format": "date-time",
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "description": "Inclusive upper bound; microsecond precision",
            "in": "query",
            "name": "filter[created_before]",
            "required": false,
            "schema": {
              "format": "date-time",
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_Note"
                }
              }
            },
            "description": "Notes ordered by creation time and ID descending"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Malformed or unsupported query parameters"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Missing or invalid access token",
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Missing required scope"
          },
          "408": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Deadline exceeded"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid limit or cursor"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Rate exceeded; retry after the indicated seconds",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Database, authentication or request capacity unavailable"
          }
        },
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ],
        "tags": [
          "notes::http"
        ],
        "x-rate-policy": "api",
        "x-required-scope": "notes:read"
      },
      "post": {
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateNote"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Data_Note"
                }
              }
            },
            "description": "Created note"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Malformed JSON"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Missing or invalid access token",
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Missing required scope"
          },
          "408": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Deadline exceeded"
          },
          "413": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Body too large"
          },
          "415": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Expected JSON"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid note"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Rate exceeded; retry after the indicated seconds",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Database, authentication or request capacity unavailable"
          }
        },
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ],
        "tags": [
          "notes::http"
        ],
        "x-rate-policy": "writes",
        "x-required-scope": "notes:write"
      }
    },
    "/example/notes/{id}": {
      "get": {
        "operationId": "get_note",
        "parameters": [
          {
            "description": "Note ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Data_Note"
                }
              }
            },
            "description": "Note"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid ID"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Missing or invalid access token",
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Missing required scope"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Missing note"
          },
          "408": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Deadline exceeded"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Rate exceeded; retry after the indicated seconds",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Database, authentication or request capacity unavailable"
          }
        },
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ],
        "tags": [
          "notes::http"
        ],
        "x-rate-policy": "api",
        "x-required-scope": "notes:read"
      }
    },
    "/healthz": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Data_Health"
                }
              }
            },
            "description": "Process alive; no dependencies checked"
          }
        },
        "tags": []
      }
    },
    "/readyz": {
      "get": {
        "operationId": "ready",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Data_Health"
                }
              }
            },
            "description": "Database query succeeds"
          },
          "408": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Configured request deadline exceeded"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Database unavailable"
          }
        },
        "tags": []
      }
    }
  }
}
