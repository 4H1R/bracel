# Local credentials only; scripts/dev.sh loads this via .env.
DATABASE_URL=postgres://starter:starter@127.0.0.1:5432/starter
BIND_ADDR=127.0.0.1:3000
ENABLE_EXAMPLE=false
DB_MAX_CONNECTIONS=10
CACHE_CAPACITY_BYTES=16777216
CACHE_TTL_SECONDS=60
CACHE_MAX_ITEM_BYTES=1048576
REQUEST_TIMEOUT_MS=10000
BODY_LIMIT_BYTES=16384
# Local user accounts issue opaque bearer tokens; bearer selects an external JWT issuer.
AUTH_MODE=local
ENABLE_ACCOUNTS=true
ALLOW_REGISTRATION=true
# Local Mailpit; run auth:mail-work in a separate terminal for password resets.
MAIL_LOCAL_PORT=1025
MAIL_FROM='Bracel <noreply@example.test>'
# Production uses a TLS relay instead of MAIL_LOCAL_PORT:
# MAIL_SMTP_HOST=smtp.example.com
# MAIL_SMTP_USERNAME=...
# MAIL_SMTP_PASSWORD=...
# AUTH_ISSUER=https://issuer.example
# AUTH_AUDIENCE=starter-api
# AUTH_PUBLIC_KEY_PEM='-----BEGIN PUBLIC KEY-----
# ...issuer public key...
# -----END PUBLIC KEY-----'
CORS_ORIGINS=
RATE_ANONYMOUS_PER_MINUTE=120
RATE_AUTHENTICATED_PER_MINUTE=60
RATE_WRITES_PER_MINUTE=20
RATE_MAX_KEYS=10000
MAX_IN_FLIGHT=64

# Optional rotating key set; use instead of AUTH_PUBLIC_KEY_PEM.
# AUTH_PUBLIC_KEYS_JSON='{"key-2026":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"}'
# Enable only with AUTH_MODE=bearer and the token migration applied.
AUTH_MACHINE_TOKENS=false

# Compile with --features batteries,identity,telemetry before enabling these workflows.
ENABLE_BATTERIES=false
# FILES_ROOT=.scratch/uploads
# MAIL_LOCAL_PORT=1025
# NOTIFY_EMAIL=developer@example.test
# WEBHOOK_URL=http://127.0.0.1:8081/events
# WEBHOOK_SECRET=replace-with-at-least-32-random-bytes
# WEBHOOK_INCOMING_SECRET=replace-with-at-least-32-random-bytes
# AUTH_DISCOVERY_URL=https://issuer.example
TRUSTED_PROXY_CIDRS=
HTTP_COMPRESSION=false
# OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
